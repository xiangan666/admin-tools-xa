jm_at.infop.cl_title=Información sobre claims de tierras
jm_at.infop.gen_afk_head=§9§lDetección AFK§r %1$s§r\n
jm_at.infop.gen_afk_kick_off=§2Desactivada§r
## [tx] Substituted after "AFK kick:" in gen_afk_on; %1$s = number of idle minutes before the player
